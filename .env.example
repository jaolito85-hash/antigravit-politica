# Supabase (Projeto separado para política)
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Evolution API (WhatsApp)
EVOLUTION_API_URL=your_evolution_url
EVOLUTION_API_KEY=your_evolution_key
EVOLUTION_INSTANCE_NAME=your_instance

# OpenAI
OPENAI_API_KEY=your_openai_key

# Apify (Instagram scraper)
# Cadastro gratuito: https://apify.com → Settings → Integrations → API token
# Free tier: US$5/mês de crédito (~5.000 posts)
APIFY_TOKEN=your_apify_token

# Gabinete Digital (assistente privado do deputado)
# JID do WhatsApp do deputado autorizado a falar com o assistente executivo.
# Formato Evolution: 5531999999999@s.whatsapp.net
# Para múltiplos números, separe por vírgula.
DEPUTADO_WHATSAPP_JID=
# Modelo OpenAI usado pelo gabinete (default: gpt-4o).
GABINETE_MODEL=gpt-4o

# SMTP — disparos oficiais de email pelo Gabinete Digital.
# Para Gmail: ative 2FA e gere uma App Password em https://myaccount.google.com/apppasswords
# Use a App Password (16 caracteres), NUNCA a senha real da conta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASS=app_password_16_chars
SMTP_FROM_EMAIL=seu_email@gmail.com
SMTP_FROM_NAME=Gabinete do Deputado

# Google Calendar (Fase 2 — agendar reuniões a partir dos chamados)
# Crie OAuth client em https://console.cloud.google.com → Credenciais
# redirect_uri autorizado: https://SEU_DOMINIO/api/calendar/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional — se nao setado, o backend monta com base no host da requisicao
GOOGLE_REDIRECT_URI=
# Convidados adicionados automaticamente em toda reuniao agendada
# (ex.: socio que precisa ver a agenda do deputado). Varios, separe por virgula.
GOOGLE_CALENDAR_CONVIDADOS_PADRAO=

# Server
PORT=5004
