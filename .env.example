# Supabase (Projeto separado para política)
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Evolution API (WhatsApp)
EVOLUTION_API_URL=your_evolution_url
EVOLUTION_API_KEY=your_evolution_key
EVOLUTION_INSTANCE_NAME=your_instance

# OpenAI
OPENAI_API_KEY=your_openai_key

# Apify (Instagram scraper)
# Cadastro gratuito: https://apify.com → Settings → Integrations → API token
# Free tier: US$5/mês de crédito (~5.000 posts)
APIFY_TOKEN=your_apify_token

# Gabinete Digital (assistente privado do deputado)
# JID do WhatsApp do deputado autorizado a falar com o assistente executivo.
# Formato Evolution: 5531999999999@s.whatsapp.net
# Para múltiplos números, separe por vírgula.
DEPUTADO_WHATSAPP_JID=
# Modelo OpenAI usado pelo gabinete (default: gpt-4o).
GABINETE_MODEL=gpt-4o
# Defaults usados pelas tools do Marcos quando o Deputado nao especifica:
# nome do candidato da campanha (usado em briefing, analise de video, etc.)
CANDIDATO_PADRAO=
# Handle do Instagram do candidato (sem @). Usado por briefing_radar_completo.
CANDIDATO_INSTAGRAM_PADRAO=
# Adversarios principais (separados por virgula) para Radar e analise.
ADVERSARIOS_PADRAO=

# SMTP — disparos oficiais de email pelo Gabinete Digital.
# Para Gmail: ative 2FA e gere uma App Password em https://myaccount.google.com/apppasswords
# Use a App Password (16 caracteres), NUNCA a senha real da conta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASS=app_password_16_chars
SMTP_FROM_EMAIL=seu_email@gmail.com
SMTP_FROM_NAME=Gabinete do Deputado

# Google Calendar (Fase 2 — agendar reuniões a partir dos chamados)
# Crie OAuth client em https://console.cloud.google.com → Credenciais
# redirect_uri autorizado: https://SEU_DOMINIO/api/calendar/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional — se nao setado, o backend monta com base no host da requisicao
GOOGLE_REDIRECT_URI=
# Convidados adicionados automaticamente em toda reuniao agendada
# (ex.: socio que precisa ver a agenda do deputado). Varios, separe por virgula.
GOOGLE_CALENDAR_CONVIDADOS_PADRAO=

# Server
PORT=5004

# Segurança do Flask
# Gerar com: python -c "import secrets; print(secrets.token_hex(32))"
# Se não setado, server gera uma chave aleatória no boot (sessões caem a cada restart).
SECRET_KEY=

# Cookies só via HTTPS em produção (true). Em dev local sem HTTPS, deixe false.
SESSION_COOKIE_SECURE=true

# Vídeos & Podcasts (análise estratégica via Whisper + GPT-4o)
# VIDEOS_TMP_DIR: pasta efêmera para áudios baixados (limpa a cada 24h)
VIDEOS_TMP_DIR=/tmp/nodedata_videos
# Cap mensal em USD. Se gasto do mês >= esse valor, /api/videos/analisar retorna HTTP 402.
# 200 USD cobre ~100 vídeos/mês com mix médio (70% 1h, 20% 2h, 10% 3h).
VIDEOS_BUDGET_USD_MONTH=200
# Actor do Apify usado pra pegar transcript do YouTube quando o IP do servidor
# (datacenter) é bloqueado tanto no yt-dlp quanto no endpoint público de captions.
# Default: pintostudio~youtube-transcript-scraper. Outras opções comuns:
#   - streamers~youtube-scraper (mais completo, mais caro)
#   - karamelo~youtube-transcript-downloader
APIFY_YOUTUBE_TRANSCRIPT_ACTOR=pintostudio~youtube-transcript-scraper
# Cookies do YouTube — OBRIGATÓRIO em servidores datacenter (Coolify, AWS, GCP)
# porque o YouTube bloqueia downloads sem cookies com "Sign in to confirm you're not a bot".
# Use UMA das duas opções abaixo (não ambas):
#   1) YT_DLP_COOKIES_CONTENT: cole o conteúdo inteiro do cookies.txt direto aqui.
#      Mais simples no Coolify (não precisa montar volume). Exportar via extensão
#      "Get cookies.txt LOCALLY" (Chrome) ou "cookies.txt" (Firefox) com YouTube logado.
#   2) YT_DLP_COOKIES_FILE: caminho do cookies.txt já montado no container.
YT_DLP_COOKIES_CONTENT=
YT_DLP_COOKIES_FILE=

# Bootstrap de credenciais — criar usuário admin via:
# python execution/criar_usuario_painel.py --username admin --role admin
# (o script gera uma senha forte e mostra UMA vez; salve no gerenciador de senhas).
# Após criar o admin, configure 2FA fazendo login e acessando /setup-2fa.
