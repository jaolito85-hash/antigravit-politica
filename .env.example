# Supabase (Projeto separado para política)
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Evolution API (WhatsApp)
EVOLUTION_API_URL=your_evolution_url
EVOLUTION_API_KEY=your_evolution_key
EVOLUTION_INSTANCE_NAME=your_instance

# OpenAI
OPENAI_API_KEY=your_openai_key

# Apify (Instagram scraper)
# Cadastro gratuito: https://apify.com → Settings → Integrations → API token
# Free tier: US$5/mês de crédito (~5.000 posts)
APIFY_TOKEN=your_apify_token

# Gabinete Digital (assistente privado do deputado)
# JID do WhatsApp do deputado autorizado a falar com o assistente executivo.
# Formato Evolution: 5531999999999@s.whatsapp.net
# Para múltiplos números, separe por vírgula.
DEPUTADO_WHATSAPP_JID=
# Modelo OpenAI usado pelo gabinete (default: gpt-4o).
GABINETE_MODEL=gpt-4o

# Server
PORT=5004
